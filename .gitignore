# ============================================================
# 皇甫谧数字人文平台 — .gitignore
# ============================================================

# --- OS Generated ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDE ---
.idea/
*.iml
*.swp
*.swo
*~
.vscode/settings.local.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
sdist/
*.egg
*.whl
instance/
.venv/
venv/
.uv/
*.sage.py

# --- Python test ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
coverage.json
*.cover

# --- Python type checking ---
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# --- Ruff ---
.ruff_cache/

# --- Node ---
node_modules/
.npm/
.yarn/
.pnpm-store/
*.tsbuildinfo
.next/
.nuxt/
.output/
.docusaurus/

# --- Backups ---
backups/

# --- Env files ---
.env
.env.*
!.env.example

# --- Docker ---
.docker/

# --- Databases (local dev) ---
*.db
*.sqlite
*.sqlite3

# --- Logs ---
*.log
logs/

# --- Temp ---
tmp/
temp/
.tmp/
*.tmp

# --- Sensitive ---
*.pem
*.key
*.crt
credentials.json
service-account.json

# --- AI ---
.agents/
.claude/memory/
.claude/plans/
.claude/agent-*.jsonl
.claude/worktrees/

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.backup
terraform.tfvars

# --- Playwright / E2E ---
.playwright-cli/
apps/frontend/.playwright-cli/
output/playwright/
apps/backend/output/playwright/
apps/backend/output/p0_*.json

# E2E trace/screenshot artifacts (root — prevent accidental commit)
/reaudit*.png
/playwright-report/
/test-results/

# --- OCR / PDF / Image artifacts ---
output/ocr_tmp/
output/*.pdf
output/*.png
output/p0_page_images/
output/p0_ocr_page_images/
output/hfb_pdf_ocr_pages.json
output/p0_page_image_artifact.json
output/p0_*_preprocessed.png
output/p0_page_*_v2.png

# --- Runtime evidence (not for release) ---
output/batch4/
output/p0_codex_commands_evidence.txt
output/p0_e2e_evidence.json
output/p0_withdraw_test.json
output/p1_delete_withdraw_evidence.txt
output/p1_isolated_db_evidence.txt
output/v4-graph-lineage-scan.json
scripts/p0_e2e_verify.js

# --- Stale duplicate directory (root-level only) ---
/backend/

# --- Deprecated docs-upgrade package (scripts already applied at root) ---
hfb_docs_upgrade_package/

# --- Workflow / agent artifacts ---
skills-lock.json
CONTEXT-MAP.md
docs/agents/
docs/superpowers/
session-report-*.html

# --- Misc ---
*.bak
*.orig
.cache/
backups/
.eslintcache
