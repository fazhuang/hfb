{
  "name": "@hfb/frontend",
  "version": "0.2.0",
  "private": true,
  "description": "HFB Frontend — Vue 3 Application",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "npm run typecheck",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "check-design": "node scripts/check-design-compliance.mjs",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "pinia": "^2.3.0",
    "vis-data": "^8.0.3",
    "vis-network": "^10.1.0",
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.0",
    "vue-router": "^4.5.0",
    "@iconify/vue": "^5.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.2.0"
  }
}
