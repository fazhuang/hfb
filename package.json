{
  "name": "huangfumi-platform",
  "version": "0.2.0",
  "private": true,
  "description": "皇甫谧数字人文与中医经典智能研究平台 — Monorepo Root",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @hfb/frontend run test",
    "test:watch": "pnpm --filter @hfb/frontend run test:watch",
    "test:coverage": "pnpm --filter @hfb/frontend run test -- --coverage",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "lint-staged": "^15.4.0",
    "playwright": "^1.61.1",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,jsx,mjs,cjs}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css,scss,html}": [
      "prettier --write"
    ],
    "*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  },
  "pnpm": {
    "overrides": {
      "vue": "^3.5.0",
      "brace-expansion": "^5.0.8",
      "js-yaml@>=4.0.0 <4.3.0": "^4.3.0",
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "postcss@>=8.0.0 <8.5.18": "^8.5.18",
      "vue-i18n": "^10.0.8"
    }
  }
}
