{
  "name": "皇甫谧数字人文与中医经典智能研究平台",
  "name_en": "Huangfu Mi Digital Humanities & TCM Classics Intelligent Research Platform",
  "short_name": "HFB",
  "version": "0.2.0",
  "sprint": "Sprint 0.2 — Repository Foundation",
  "created": "2025-06-22",
  "updated": "2025-06-24",
  "license": {
    "docs": "CC BY-NC-SA 4.0",
    "code": "MIT"
  },

  "architecture": {
    "type": "monorepo",
    "backend": {
      "language": "Python 3.12",
      "framework": "FastAPI",
      "orm": "SQLAlchemy 2.0 (async)",
      "validation": "Pydantic v2",
      "api_spec": "OpenAPI 3.1",
      "location": "apps/backend/"
    },
    "frontend": {
      "language": "TypeScript 5.7",
      "framework": "Vue 3",
      "build_tool": "Vite",
      "state_mgmt": "Pinia",
      "location": "apps/frontend/"
    },
    "databases": {
      "primary": {
        "engine": "PostgreSQL 16",
        "extension": "pgvector",
        "role": "主存储 / 向量存储"
      },
      "graph": {
        "engine": "Neo4j 5",
        "role": "知识图谱存储与推理"
      },
      "vector": {
        "engine": "Milvus 2.4",
        "role": "语义检索 / RAG 向量库"
      },
      "search": {
        "engine": "Elasticsearch 8",
        "role": "全文检索"
      }
    },
    "ai": {
      "llm_framework": "LangChain / LlamaIndex",
      "patterns": ["RAG", "GraphRAG"],
      "embedding": "text-embedding-3-small (default)"
    },
    "infrastructure": {
      "container": "Docker + Docker Compose",
      "orchestration": "Kubernetes (planned)",
      "ci_cd": "GitHub Actions",
      "package_manager": {
        "python": "uv / pip",
        "node": "pnpm 10"
      }
    }
  },

  "docs": {
    "root": "docs/",
    "index": "docs/documentation-index.md",
    "sections": {
      "00-governance": "项目治理、Constitution、文档规则 — 最高约束力",
      "01-product": "Product Charter — 愿景、路线图、用户画像",
      "02-architecture": "Blueprint — 系统架构蓝图、技术选型",
      "03-data": "Data Standard — 数据标准、本体规范",
      "04-ai": "AI Engineering Standard — RAG/GraphRAG 架构、模型标准",
      "05-development": "Development Specification — 开发规范、工具链",
      "06-ui": "Design System — UI 设计系统、组件规范",
      "07-security": "Security Specification — 安全规范、验收标准",
      "08-sprints": "Sprint Management — 迭代规划与执行记录",
      "09-prompts": "Prompt Engineering — AI 提示词模板库",
      "10-diagrams": "Architecture Diagrams — 系统架构图、ER 图",
      "11-adr": "Architecture Decision Records (ADR-0001 ~ ADR-0010)",
      "12-context": "Context Data — 各 Sprint 上下文快照 (Sprint00 ~ Sprint16)",
      "13-machine": "Machine-Readable Metadata — 本体、实体、关系、API 索引 JSON",
      "14-knowledge": "Knowledge Base — 书籍、人物、论文等知识资产",
      "15-decision-tree": "Decision Trees — 架构、前端、数据库、AI、部署决策树"
    },
    "adr_count": 10,
    "adr_latest": "ADR-0010 (AI-Native Development)"
  },

